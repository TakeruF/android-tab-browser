<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <service android:name=".testing.PasskeyHarnessService" android:label="Nagi passkey test harness"
            android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE" android:exported="true"
            android:enabled="@bool/test_passkey_provider_enabled" tools:targetApi="34">
            <intent-filter><action android:name="android.service.credentials.CredentialProviderService" /></intent-filter>
            <meta-data android:name="android.credentials.provider" android:resource="@xml/test_credential_provider" />
        </service>
        <service android:name=".testing.AutofillHarnessService" android:label="Nagi autofill test harness"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE" android:exported="true">
            <intent-filter><action android:name="android.service.autofill.AutofillService" /></intent-filter>
        </service>
        <service android:name=".testing.InputConnectionHarnessIme" android:label="Nagi input test harness"
            android:permission="android.permission.BIND_INPUT_METHOD" android:exported="true">
            <intent-filter><action android:name="android.view.InputMethod" /></intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/test_input_method" />
        </service>
    </application>
</manifest>
